# CardioSense AI backend settings. Copy to backend/.env (all optional in dev; defaults shown).
CARDIOSENSE_ENV=dev
CARDIOSENSE_DATABASE_URL=postgresql+asyncpg://cardiosense:cardiosense@localhost:5432/cardiosense
# Required outside dev: a long random string. Access tokens are HS256 JWTs signed with it.
CARDIOSENSE_JWT_SECRET=dev-only-change-me-cardiosense-jwt-secret-0123456789
CARDIOSENSE_ACCESS_TTL_MIN=15
CARDIOSENSE_REFRESH_TTL_DAYS=14
CARDIOSENSE_DEVICE_KEY_PEPPER=dev-only-device-key-pepper
CARDIOSENSE_PAIRING_CODE_TTL_MIN=10

# Seed: org "CardioSense Demo Clinic", four users (password below), three demo patients + 14 days of demo history.
CARDIOSENSE_SEED=1
CARDIOSENSE_SEED_HISTORY_DAYS=14
CARDIOSENSE_SEED_PASSWORD=CardioSense!23
# Load tests: also create N paired demo devices dev-soak-000.. (keys soak-key-000..); or POST /v1/demo/soak-devices
CARDIOSENSE_SEED_SOAK_DEVICES=0

# Pipeline. Missing model files => rules-only mode (all beats "Unknown", model_loaded=false).
# CARDIOSENSE_MODEL_DIR=/abs/path/to/ml/models/cardiosense_beat_model
CARDIOSENSE_PIPELINE_THREADS=4
CARDIOSENSE_TORCH_THREADS=1
CARDIOSENSE_SIGNAL_CHUNK_S=1.0
CARDIOSENSE_STREAM_IDLE_TIMEOUT_S=30

# Demo replay: the backend spawns the sender CLI, which connects back to this URL.
# CARDIOSENSE_DATA_DIR=/abs/path/to/data/records
# CARDIOSENSE_SENDER_SCRIPT=/abs/path/to/sender/stream_sender.py
# CARDIOSENSE_SENDER_PYTHON=/home/you/.venvs/cardiosense/bin/python
CARDIOSENSE_SELF_WS_URL=ws://localhost:8000

CARDIOSENSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Copilot. Without a key (or on any LLM failure / guardrail rejection) the rules-based template is used.
# ANTHROPIC_API_KEY=
CARDIOSENSE_LLM_MODEL=claude-opus-5-5
CARDIOSENSE_LLM_TIMEOUT_S=20
CARDIOSENSE_LLM_ENABLED=1

# Alert notifications. Without SMTP, e-mail attempts are recorded as "logged". Webhook is optional.
# CARDIOSENSE_SMTP_HOST=
# CARDIOSENSE_SMTP_PORT=587
# CARDIOSENSE_SMTP_USER=
# CARDIOSENSE_SMTP_PASSWORD=
# CARDIOSENSE_SMTP_FROM=alerts@cardiosense.dev
# CARDIOSENSE_ALERT_WEBHOOK_URL=
